# Client (bundled by Vite — safe to expose)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_ROOT_FOLDER=PMSI
# Optional: use shared PMSI folder ID directly (skips name search when set)
VITE_GOOGLE_DRIVE_PMSI_FOLDER_ID=

# Server only (never use VITE_ prefix for secrets)
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
